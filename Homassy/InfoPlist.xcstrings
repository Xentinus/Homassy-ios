    "NSCameraUsageDescription" : {
      "comment" : "Camera permission prompt (barcode scanner, product photo)",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homassy verwendet die Kamera, um Barcodes zu scannen und Produktfotos aufzunehmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homassy uses the camera to scan barcodes and to take product photos."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Homassy a kamerát vonalkódok beolvasására és termékfotók készítésére használja."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Location permission prompt (nearby shops)",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homassy verwendet deinen Standort nur, um Geschäfte in deiner Nähe zu finden. Er wird weder gespeichert noch geteilt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homassy uses your location only to find shops near you. It is not stored or shared."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Homassy a helyzetedet csak a közeli üzletek megkereséséhez használja. Nem tárolja és nem osztja meg."
          }
        }
      }
    }
  },
