{
  "sourceLanguage" : "en",
  "strings" : {
    "gate.checking" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud wird geprüft…"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checking iCloud…"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud ellenőrzése…"
          }
        }
      }
    },
    "gate.noAccount.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homassy speichert deine Daten in deiner eigenen iCloud. Melde dich in den Einstellungen bei iCloud an, um fortzufahren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homassy keeps your data in your own iCloud. Sign in to iCloud in Settings to continue."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Homassy a saját iCloudodban tárolja az adataidat. A folytatáshoz jelentkezz be az iCloudba a Beállításokban."
          }
        }
      }
    },
    "gate.openSettings" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einstellungen öffnen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Settings"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beállítások megnyitása"
          }
        }
      }
    },
    "gate.required.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud erforderlich"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud is required"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud szükséges"
          }
        }
      }
    },
    "gate.restricted.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud ist auf diesem Gerät eingeschränkt, etwa durch Bildschirmzeit oder ein Geräteverwaltungsprofil. Bitte die Person, die dieses Gerät verwaltet, iCloud zu erlauben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud is restricted on this device, for example by Screen Time or a device management profile. Ask the person who manages this device to allow iCloud."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az iCloud használata korlátozva van ezen az eszközön, például a Képernyőidő vagy egy eszközkezelési profil miatt. Kérd meg az eszköz kezelőjét, hogy engedélyezze az iCloudot."
          }
        }
      }
    },
    "gate.retry" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erneut versuchen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Try again"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Újrapróbálás"
          }
        }
      }
    },
    "gate.unavailable.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe deine Verbindung und die iCloud-Einstellungen und versuche es dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check your connection and your iCloud settings, then try again."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ellenőrizd a kapcsolatot és az iCloud-beállításokat, majd próbáld újra."
          }
        }
      }
    },
    "gate.unavailable.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud ist vorübergehend nicht verfügbar"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud is temporarily unavailable"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az iCloud átmenetileg nem érhető el"
          }
        }
      }
    },
    "gate.unknown.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homassy konnte dein iCloud-Konto nicht prüfen. Versuche es gleich noch einmal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homassy couldn't check your iCloud account. Try again in a moment."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Homassy nem tudta ellenőrizni az iCloud-fiókodat. Próbáld újra egy kicsit később."
          }
        }
      }
    },
    "gate.unknown.title" : {
