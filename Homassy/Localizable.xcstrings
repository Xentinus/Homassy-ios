    "gate.required.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud erforderlich"
          }
        },
        "en" : {
          "stringUnit" : {
